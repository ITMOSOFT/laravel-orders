{
    "name": "itmosoft/laravel-orders",
    "description": "Order management for Laravel applications with immutable item snapshots and auditable status transitions.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ItmoSoft\\Orders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ItmoSoft\\Orders\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ItmoSoft\\Orders\\OrdersServiceProvider"
            ],
            "aliases": {
                "Orders": "ItmoSoft\\Orders\\Facades\\Orders"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
